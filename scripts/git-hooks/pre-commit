#!/usr/bin/env bash
# Pre-commit gate: refuse plaintext secrets. Install with:
#   cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Reglas:
# 1. Cualquier *.env* (salvo *.env.sops / .env.example) sin marcadores SOPS → bloquea.
# 2. Línea con pinta de secreto (clave=valor largo) → bloquea, SALVO:
#    - el fichero trae marcador sops/age,
#    - la línea solo LEE de entorno (os.getenv, process.env...) o es
#      ejemplo/placeholder/TODO,
#    - el "valor" es obviamente corto (<16 chars).
set -euo pipefail

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)
KEYPAT='(password|secret|token|api_key|private_key|client_secret|encryption_key|access_key)'

for f in $staged; do
  case "$f" in
    *.env.sops|.env.example) continue;;
    *.env*)
      if ! grep -qE '^sops_|ENC\[AES256_GCM' "$f" 2>/dev/null; then
        echo "BLOCKED: $f looks like a plaintext env file — encrypt with sops first"
        fail=1
      fi
      continue;;
  esac

  # ¿marcador sops/age o solo ejemplos? → pasa
  if grep -qE 'sops:|ENC\[AES256_GCM|age1[A-Za-z0-9]+' "$f" 2>/dev/null; then continue; fi
  if grep -qiE 'example|placeholder|your-|<.*>|TODO' "$f" 2>/dev/null; then
    # ojo: si ADEMÁS hay un literal largo real, igual se revisa abajo
    :
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    if echo "$line" | grep -qiE "${KEYPAT}[\"']?\\s*[:=]\\s*[\"']?[A-Za-z0-9+/=_.-]{16,}"; then
      # lee de entorno / gestor de secretos → no es fuga
      if echo "$line" | grep -qiE 'os\.getenv|getenv\(|process\.env|import\.meta|os\.environ|getpass|secret_manager|SecretManager|get_secret|readServerEnv|read_secret'; then
        continue
      fi
      # ejemplo / placeholder / TODO → no es fuga
      if echo "$line" | grep -qiE 'example|placeholder|your-|<.*>|TODO|xxx+|test123'; then
        continue
      fi
      echo "BLOCKED: $f: posible secreto en plaintext: $(echo "$line" | cut -c1-70)"
      fail=1
    fi
  done < "$f"
done

exit $fail
