# Copy this file to .env and fill in real values. NEVER commit .env.

# LLM provider
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# LangSmith observability (optional)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=your-langsmith-project

# n8n lead webhook (JWT-protected)
N8N_LEAD_WEBHOOK_URL=https://your-n8n-host.example/webhook/your-webhook-path
N8N_LEAD_WEBHOOK_SECRET=your-shared-jwt-secret

# Browser origins allowed to call the chat API
CORS_ORIGINS=https://your-site.example,http://localhost:4321

# Rate limiting
RATE_LIMIT=20
RATE_LIMIT_WINDOW=60
THREAD_RATE_LIMIT=20
THREAD_RATE_LIMIT_WINDOW=60

# Conversation limits
MAX_TURNS=24
THREAD_TOKEN_BUDGET=8000

CHAT_API_TOKEN=
# If set, widget must send header X-Chat-Token: $CHAT_API_TOKEN on every /api/chat call
# Leave empty in dev to disable auth; set a long random string in Portainer for prod
# /health stays unauthenticated for uptime monitors