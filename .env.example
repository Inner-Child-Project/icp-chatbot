OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini

LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=icp-chatbot

N8N_LEAD_WEBHOOK_URL=https://n8n.innerchildproject.us/webhook/icp-lead
N8N_LEAD_WEBHOOK_SECRET=
CORS_ORIGINS=https://growbusy.net,https://www.growbusy.net,https://products.innerchildproject.us,http://localhost:4321

RATE_LIMIT=20
RATE_LIMIT_WINDOW=60
THREAD_RATE_LIMIT=20
THREAD_RATE_LIMIT_WINDOW=60
MAX_TURNS=24
THREAD_TOKEN_BUDGET=8000

CHAT_API_TOKEN=
# If set, widget must send header X-Chat-Token: $CHAT_API_TOKEN on every /api/chat call
# Leave empty in dev to disable auth; set a long random string in Portainer for prod
# /health stays unauthenticated for uptime monitors
